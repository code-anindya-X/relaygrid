POSTGRES_DB=relaygrid
POSTGRES_USER=relaygrid
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://relaygrid:local-development-only@localhost:5432/relaygrid
JDBC_URL=jdbc:postgresql://localhost:5432/relaygrid

TRUEFOUNDRY_AI_GATEWAY_URL=
TRUEFOUNDRY_API_KEY=
OPENAI_API_KEY=
MODEL_NAME=
TRUEFORGE_URL=http://localhost:8790
# Local standalone TrueForge may call RelayGrid's loopback MCP endpoint.
OUTBOUND_URL_ALLOWED_HOSTS='["127.0.0.1","localhost"]'
# Set when more than one model is configured in TrueForge.
TRUEFORGE_MODEL_NAME=
# Only needed when the TrueForge API itself uses authentication.
TRUEFORGE_API_TOKEN=

IMPACT_ENGINE_URL=http://localhost:8002
# Shared only between the control plane, Operations MCP and impact engine for
# state-changing incident remediation calls.
IMPACT_ENGINE_INTERNAL_TOKEN=local-impact-service-token-change-me
CONTROL_PLANE_INTERNAL_TOKEN=local-control-plane-service-token-change-me
# Explicitly permits volatile Proofline fallback only when the impact engine
# confirms that PostgreSQL is not configured and demo-memory is authoritative.
ALLOW_DEMO_MEMORY_ACTIONS=true
# Keep false when the MCP and impact-engine tokens above are configured.
ALLOW_INSECURE_LOCAL_DEMO=false
PROOFLINE_URL=http://localhost:8082
OPS_MCP_URL=http://localhost:8083
# Use a reachable HTTPS URL when TrueForge is not running on this machine.
OPS_MCP_PUBLIC_URL=
MCP_HOST=127.0.0.1
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
MCP_BEARER_TOKEN=local-mcp-token-change-me
PROOFLINE_INTERNAL_TOKEN=local-proofline-service-token-change-me
CONTROL_PLANE_URL=http://localhost:8084
CONTROL_PLANE_HOST=127.0.0.1
WAREHOUSE_ENGINE_URL=http://localhost:8002
CONSOLE_ORIGIN=http://localhost:5173
# Local demo operator unlock. Replace both secrets before any shared deployment.
CONSOLE_OPERATOR_ACCESS_CODE=relaygrid-demo
CONSOLE_SESSION_SECRET=relaygrid-local-demo-session-secret-change-before-production-2026
CONSOLE_OPERATOR_NAME='Alex Sharma'
CONSOLE_OPERATOR_ROLE=operator

# Configure only in a local .env; never commit production credentials.
